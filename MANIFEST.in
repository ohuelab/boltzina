global-exclude __pycache__
global-exclude *.py[cod]
prune boltzina.egg-info
prune tests
prune sample
prune scripts
prune local
prune .venv
exclude mf-pcba_test.zip
exclude maxit.log

include NOTICE
include docs/bioir.md
include containers/Dockerfile.bioir
include containers/bioir.def
include containers/install-bioir.sh
include environments/bioir/pyproject.toml
include environments/bioir/uv.lock
