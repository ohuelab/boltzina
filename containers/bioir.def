Bootstrap: docker
From: python:3.12-slim-bookworm

%files
    pyproject.toml /opt/boltzina/pyproject.toml
    README.md /opt/boltzina/README.md
    LICENSE /opt/boltzina/LICENSE
    NOTICE /opt/boltzina/NOTICE
    LICENSES /opt/boltzina/LICENSES
    boltzina /opt/boltzina/boltzina
    environments/bioir/pyproject.toml /opt/boltzina/environments/bioir/pyproject.toml
    environments/bioir/uv.lock /opt/boltzina/environments/bioir/uv.lock
    containers/install-bioir.sh /opt/boltzina/containers/install-bioir.sh

%post
    sh /opt/boltzina/containers/install-bioir.sh

%environment
    export PATH="/opt/boltzina/environments/bioir/.venv/bin:$PATH"
    export BOLTZINA_VINA_PATH=/opt/boltzina-tools/bin/vina
    export BOLTZINA_MAXIT_PATH=/opt/boltzina-tools/maxit-v11.300-prod-src/bin/maxit
    export RCSBROOT=/opt/boltzina-tools/maxit-v11.300-prod-src
    export BOLTZ_CACHE=/cache/boltz
    export XDG_CACHE_HOME=/cache/boltz/runtime
    export NUMBA_CACHE_DIR=/cache/boltz/runtime/numba
    export TRITON_CACHE_DIR=/cache/boltz/runtime/triton
    export CUEQ_TRITON_CACHE_DIR=/cache/boltz/runtime/cuequivariance
    export CUDA_CACHE_PATH=/cache/boltz/runtime/cuda

%runscript
    exec boltzina "$@"

%test
    /opt/boltzina/environments/bioir/.venv/bin/boltzina run --help
